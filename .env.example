AI_API_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
AI_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-5.6-luna
OPENROUTER_MODEL=openai/gpt-5.6-luna
AI_SCORING_MODEL=openai/gpt-5.6-luna
AI_SUMMARY_MODEL=openai/gpt-5.6-luna
# Scoring needs more time (many articles to score), summary needs less
AI_SCORING_TIMEOUT_MS=90000
AI_SUMMARY_TIMEOUT_MS=60000
AI_TIMEOUT_MS=60000
OPENROUTER_TIMEOUT_MS=60000
AI_MAX_RETRIES=3
OPENROUTER_MAX_RETRIES=3

# Set to true only for local/editorial preview builds that need to render draft content.
TANTECH_INCLUDE_DRAFTS=false