---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getArticleHref, getPublishedNews } from "../../utils/content";
import { getRelatedNews } from "../../utils/related-news";

export async function getStaticPaths() {
    const articles = await getPublishedNews();
    const paths = [];

    for (const article of articles) {
        const date = article.data.publishedAt;
        const year = String(date.getFullYear());
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const relatedArticles = getRelatedNews(article, articles, 6);

        // short slug: /news/<slug>/
        paths.push({
            params: { slug: article.slug },
            props: { article, relatedArticles },
        });

        // dated slug: /news/YYYY/MM/<slug>/ (as a string param)
        paths.push({
            params: { slug: `${year}/${month}/${article.slug}` },
            props: { article, relatedArticles },
        });
    }

    return paths;
}

const { article, relatedArticles } = Astro.props;
const requestedPath = `/news/${Astro.params.slug}/`;

if (getArticleHref(article) !== requestedPath) {
    return Astro.redirect(getArticleHref(article));
}
---

<ArticleLayout article={article} relatedArticles={relatedArticles} />
