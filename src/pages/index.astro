---
import ArticleCard from "../components/news/article-card.astro";
import JsonLd from "../components/seo/json-ld.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ARTICLE_CATEGORIES } from "../types/article";
import { getCategoryHref, getPublishedNews } from "../utils/content";
import { getOrganizationJsonLd, getSiteJsonLd } from "../utils/seo";

const articles = await getPublishedNews();
const featured = articles[0];
const rest = articles.slice(1, 8);
const leftArticles = rest.slice(0, 2);
const rightArticles = rest.slice(2, 5);
---

<BaseLayout>
  <Fragment slot="head">
    <JsonLd data={getSiteJsonLd()} />
    <JsonLd data={getOrganizationJsonLd()} />
  </Fragment>

  <section class="border-b border-line bg-white">
    <div
      class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:py-14"
    >
      <div>
        <p class="text-sm font-bold uppercase tracking-wide text-brand">
          TanTech News
        </p>
        <h1
          class="mt-3 max-w-3xl text-4xl font-extrabold leading-tight text-ink sm:text-5xl"
        >
          สรุปข่าวเทคสำคัญ ให้คุณทันทุกวัน
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">
          คัดข่าวที่มีผลกระทบจริง สรุปเป็นภาษาไทย
          แยกข้อเท็จจริงออกจากบทวิเคราะห์ และพากลับไปอ่านต้นฉบับได้เสมอ.
        </p>
      </div>
      <div class="rounded-lg border border-line bg-paper p-5">
        <p class="text-sm font-bold text-ink">หมวดข่าวหลัก</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            ARTICLE_CATEGORIES.map((category) => (
              <a
                class="rounded-md border border-line bg-white px-3 py-2 text-sm font-semibold text-muted hover:border-brand hover:text-brand"
                href={getCategoryHref(category)}
              >
                {category}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <p class="text-sm font-bold text-brand">ข่าวล่าสุด</p>
        <h2 class="mt-1 text-2xl font-bold text-ink">เรื่องที่ควรรู้ตอนนี้</h2>
      </div>
      <a
        class="text-sm font-bold text-brand hover:text-brand-dark"
        href="/archive/">ดูทั้งหมด</a
      >
    </div>

    {
      featured ? (
        <div class="grid gap-5 lg:grid-cols-2">
          <div class="grid gap-5">
            {leftArticles.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
          <div class="grid gap-5">
            {rightArticles.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        </div>
      ) : (
        <div class="rounded-lg border border-dashed border-line bg-white p-8 text-center">
          <h3 class="text-xl font-bold text-ink">ยังไม่มีข่าวที่เผยแพร่</h3>
          <p class="mt-2 text-muted">
            เมื่อ pipeline สร้างข่าวและผ่านการ review แล้ว
            ข่าวล่าสุดจะแสดงที่นี่.
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>
