---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getDailyHref, getPublishedDailyDigests } from "../../utils/content";
import { formatDate } from "../../utils/format-date";

const digests = await getPublishedDailyDigests();
---

<BaseLayout title="สรุปข่าวประจำวัน" description="หน้ารวมสรุปข่าวเทคโนโลยีประจำวันของ TanTech News">
  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <h1 class="text-3xl font-extrabold text-ink">สรุปข่าวประจำวัน</h1>
    <p class="mt-3 text-muted">รายการ digest ที่เผยแพร่แล้ว เรียงจากวันล่าสุด.</p>

    <div class="mt-8 grid gap-4">
      {digests.length > 0 ? (
        digests.map((digest) => (
          <article class="rounded-lg border border-line bg-white p-5 shadow-sm">
            <p class="text-sm font-bold text-brand">{formatDate(digest.data.date)}</p>
            <h2 class="mt-2 text-xl font-bold text-ink">
              <a href={getDailyHref(digest)}>{digest.data.title}</a>
            </h2>
            <p class="mt-2 text-sm text-muted">{digest.data.articleSlugs.length} ข่าว</p>
          </article>
        ))
      ) : (
        <p class="rounded-lg border border-dashed border-line bg-white p-6 text-muted">ยังไม่มี digest ที่เผยแพร่.</p>
      )}
    </div>
  </section>
</BaseLayout>
