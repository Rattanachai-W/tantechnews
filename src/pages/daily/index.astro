---
import BaseLayout from "../../layouts/BaseLayout.astro";
import JsonLd from "../../components/seo/json-ld.astro";
import { getDailyHref, getPublishedDailyDigests } from "../../utils/content";
import { formatDate } from "../../utils/format-date";
import { getBreadcrumbJsonLd, seoDefaults } from "../../utils/seo";

const canonical = new URL("/daily/", Astro.site).href;
const digests = await getPublishedDailyDigests();

const breadcrumbs = [
  { name: "หน้าแรก", url: `${seoDefaults.siteUrl}/` },
  { name: "สรุปข่าวประจำวัน", url: canonical }
];
---

<BaseLayout title="สรุปข่าวประจำวัน" description="หน้ารวมสรุปข่าวเทคโนโลยีประจำวันของ TanTech News — สรุปข่าวสำคัญทุกวันโดย AI">
  <Fragment slot="head">
    <JsonLd data={getBreadcrumbJsonLd(breadcrumbs)} />
  </Fragment>

  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted">
        {breadcrumbs.map((crumb, index) => (
          <li class="flex items-center gap-1.5">
            {index > 0 && <span aria-hidden="true" class="text-line">/</span>}
            {index < breadcrumbs.length - 1 ? (
              <a class="font-medium hover:text-brand" href={crumb.url}>{crumb.name}</a>
            ) : (
              <span class="font-semibold text-ink" aria-current="page">{crumb.name}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header>
      <h1 class="text-3xl font-extrabold text-ink">สรุปข่าวประจำวัน</h1>
      <p class="mt-3 text-muted">
        รายการ digest ที่เผยแพร่แล้ว เรียงจากวันล่าสุด
        {digests.length > 0 && ` — ${digests.length} วัน`}
      </p>
    </header>

    <div class="mt-8 grid gap-4">
      {digests.length > 0 ? (
        digests.map((digest) => (
          <article class="rounded-lg border border-line bg-white p-5 shadow-sm transition hover:shadow-md">
            <p class="text-sm font-bold text-brand">
              <time datetime={digest.data.date.toISOString()}>{formatDate(digest.data.date)}</time>
            </p>
            <h2 class="mt-2 text-xl font-bold text-ink">
              <a href={getDailyHref(digest)}>{digest.data.title}</a>
            </h2>
            <p class="mt-2 text-sm text-muted">{digest.data.articleSlugs.length} ข่าว</p>
          </article>
        ))
      ) : (
        <div class="rounded-lg border border-dashed border-line bg-white p-8 text-center">
          <h2 class="text-xl font-bold text-ink">ยังไม่มี digest ที่เผยแพร่</h2>
          <p class="mt-2 text-muted">digest จะปรากฏเมื่อ pipeline สร้างข่าวและผ่านการ review</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
