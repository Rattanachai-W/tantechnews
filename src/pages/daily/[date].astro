---
import ArticleCard from "../../components/news/article-card.astro";
import JsonLd from "../../components/seo/json-ld.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getDailyHref,
  getPublishedDailyDigests,
  getPublishedNews,
} from "../../utils/content";
import { formatDate } from "../../utils/format-date";
import { getBreadcrumbJsonLd, getDailyDigestJsonLd, seoDefaults } from "../../utils/seo";

export async function getStaticPaths() {
  const digests = await getPublishedDailyDigests();
  return digests.map((digest) => ({
    params: { date: digest.id.replace(/\.md$/, "") },
    props: { digest },
  }));
}

const { digest } = Astro.props;
const articles = await getPublishedNews();
const digestArticles = digest.data.articleSlugs
  .map((slug) => articles.find((article) => article.slug === slug))
  .filter((article) => article !== undefined);

if (getDailyHref(digest) !== `/daily/${Astro.params.date}/`) {
  return Astro.redirect(getDailyHref(digest));
}

const canonical = new URL(`/daily/${Astro.params.date}/`, Astro.site).href;
const breadcrumbs = [
  { name: "หน้าแรก", url: `${seoDefaults.siteUrl}/` },
  { name: "สรุปข่าวประจำวัน", url: `${seoDefaults.siteUrl}/daily/` },
  { name: formatDate(digest.data.date), url: canonical }
];
---

<BaseLayout
  title={digest.data.title}
  description={`สรุปข่าวเทคประจำวันที่ ${formatDate(digest.data.date)} — ${digestArticles.length} บทความที่คัดเลือกโดยทันเทค`}
>
  <Fragment slot="head">
    <JsonLd data={getDailyDigestJsonLd(digest.data.title, formatDate(digest.data.date), canonical, digestArticles.length)} />
    <JsonLd data={getBreadcrumbJsonLd(breadcrumbs)} />
  </Fragment>

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted">
        {breadcrumbs.map((crumb, index) => (
          <li class="flex items-center gap-1.5">
            {index > 0 && <span aria-hidden="true" class="text-line">/</span>}
            {index < breadcrumbs.length - 1 ? (
              <a class="font-medium hover:text-brand" href={crumb.url}>{crumb.name}</a>
            ) : (
              <span class="font-semibold text-ink" aria-current="page">{crumb.name}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header>
      <p class="text-sm font-bold text-brand">Daily Digest</p>
      <h1 class="mt-2 text-3xl font-extrabold leading-tight text-ink sm:text-4xl">
        {digest.data.title}
      </h1>
      <p class="mt-3 text-muted">
        สรุปรวมข่าวที่ผ่านการคัดเลือกประจำวัน
        โดยลิงก์ไปยังบทความแต่ละเรื่องแทนการทำสำเนาเนื้อหา.
      </p>
    </header>

    <div class="mt-8 grid min-w-0 gap-5 md:grid-cols-2">
      {
        digestArticles.length > 0 ? (
          digestArticles.map((article) => <ArticleCard article={article} />)
        ) : (
          <div class="rounded-lg border border-dashed border-line bg-white p-8 text-center md:col-span-2">
            <h2 class="text-xl font-bold text-ink">ยังไม่มีข่าวใน digest นี้</h2>
            <p class="mt-2 text-muted">ข่าวจะปรากฏเมื่อ pipeline สร้างข่าวและผ่านการ review</p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
