---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "เกี่ยวกับทันเทค สรุปข่าวเทคโนโลยีภาษาไทย";
const description =
  "รู้จักทันเทค (TanTech News) สื่อสรุปข่าวเทคโนโลยีภาษาไทย ขับเคลื่อนด้วย AI และ automation 100% คัดข่าวสำคัญพร้อมแหล่งอ้างอิงต้นฉบับ";
const adsMailto = `mailto:rattanachai.wp@gmail.com?subject=${encodeURIComponent("ติดต่อโฆษณา - TanTech News")}`;

const partners = [
  {
    name: "APOC Wire",
    role: "สื่อพันธมิตรในประเทศไทย",
    href: "https://apocwire.com/th/",
    logo: "/apoc-wire.jpg",
    logoAlt: "โลโก้ APOC Wire News"
  }
];

const signals = [
  { label: "AI + automation 100%", detail: "คัด กรอง วิเคราะห์ สรุป และเผยแพร่ด้วยระบบอัตโนมัติทั้ง pipeline" },
  { label: "สรุปเป็นภาษาไทย", detail: "อ่านเร็ว เข้าใจง่าย ในไม่กี่นาที" },
  { label: "มีแหล่งอ้างอิง", detail: "เปิดดูต้นฉบับและตรวจสอบย้อนกลับได้" }
];

const whyItems = [
  "อ่านสรุปข่าวเทคโนโลยีภาษาไทยที่คัดแล้ว ไม่ต้องไล่ฟีดข่าวต่างประเทศเองทั้งวัน",
  "เห็นผลกระทบต่อธุรกิจและงานพัฒนา ผ่านส่วนวิเคราะห์ที่แยกจากรายงานข้อเท็จจริง",
  "เปิดดูแหล่งข่าวต้นทางได้ทันที หากต้องการรายละเอียดเพิ่มหรือตรวจสอบข้อมูล"
];

const pillars = [
  {
    title: "AI + automation 100%",
    desc: "ทั้ง pipeline ตั้งแต่คัดกรอง วิเคราะห์ สรุป ถึงเผยแพร่ ทำงานด้วย AI และระบบอัตโนมัติทั้งหมด ไม่มีมือเรียบเรียงทีละชิ้น เพื่อคัดเฉพาะข่าวสำคัญจริงก่อนออกเป็นภาษาไทย"
  },
  {
    title: "แหล่งข่าวระดับโลกที่ตรวจสอบได้",
    desc: "รวบรวมจากแหล่งที่น่าเชื่อถือ เช่น TechCrunch, The Verge, Hacker News, GitHub Blog และ Google Blog พร้อมลิงก์ต้นฉบับทุกบทความ"
  },
  {
    title: "สรุปเพื่อผู้อ่านไทย",
    desc: "เรียบเรียงเป็นภาษาไทยที่อ่านเร็ว เน้นบริบทของนักพัฒนา ผู้ประกอบการ และคนทำงานด้านเทคโนโลยีในไทย"
  },
  {
    title: "อัปเดตเร็วและโปร่งใส",
    desc: "อัปเดตหลายรอบต่อวัน แยกข้อเท็จจริงจากมุมมองของทันเทค และเปิดเผยวิธีคัดเลือกข่าวกับนโยบายการใช้ AI"
  }
];
---

<BaseLayout title={title} description={description}>
  <!-- Hero: spacious peak -->
  <section class="relative overflow-hidden border-b border-line bg-white">
    <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-1/2 bg-gradient-to-l from-brand-light/50 to-transparent lg:block" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:items-end lg:py-24">
      <div>
        <p class="text-sm font-bold uppercase tracking-wide text-brand">เกี่ยวกับเรา</p>
        <h1 class="mt-4 max-w-[18ch] text-4xl font-extrabold leading-[1.15] text-ink sm:text-5xl lg:text-6xl">
          ทันเทค สรุปข่าวเทคโนโลยีภาษาไทยที่ควรรู้
        </h1>
        <p class="mt-4 text-base font-semibold text-brand sm:text-lg">
          ขับเคลื่อนด้วย AI และ automation 100%
        </p>
        <p class="mt-4 max-w-xl text-lg leading-8 text-muted">
          ทันเทค (TanTech News) เป็นสื่อสรุปข่าวเทคโนโลยีภาษาไทย
          ที่คัดเฉพาะข่าวมีผลกระทบจริง แล้วสรุปให้อ่านเข้าใจได้ในไม่กี่นาที
          ทั้งระบบทำงานอัตโนมัติตั้งแต่คัดข่าวถึงเผยแพร่
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/"
            class="inline-flex min-h-11 items-center rounded-lg bg-brand px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          >
            อ่านข่าวล่าสุด
          </a>
          <a
            href="/ai-policy/"
            class="inline-flex min-h-11 items-center rounded-lg border border-line bg-white px-5 py-2.5 text-sm font-semibold text-ink transition hover:border-brand hover:text-brand focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          >
            อ่านนโยบาย AI
          </a>
        </div>
      </div>

      <aside class="rounded-2xl border border-brand/25 bg-brand-light/40 p-6 sm:p-7">
        <p class="text-sm font-bold text-brand">จุดเด่นของระบบ</p>
        <p class="mt-2 text-xl font-extrabold leading-snug text-ink">
          AI + automation 100%
        </p>
        <p class="mt-3 text-sm leading-7 text-muted">
          คัด กรอง วิเคราะห์ สรุป และเผยแพร่ด้วยระบบอัตโนมัติทั้ง pipeline
          แยกข้อเท็จจริงออกจากมุมมองของทันเทคอย่างชัดเจน
        </p>
        <p class="mt-4 border-t border-brand/20 pt-4 text-sm leading-7 text-muted">
          โฟกัสข่าวที่มีผลกระทบต่อนักพัฒนา ผู้ประกอบการ และคนทำงานกับเทคโนโลยี
          พร้อมแหล่งอ้างอิงต้นฉบับให้ตรวจสอบย้อนกลับได้
        </p>
      </aside>
    </div>
  </section>

  <!-- Signal strip: high-weight beat -->
  <section class="border-b border-line bg-ink text-white" aria-label="จุดเด่นของทันเทค">
    <div class="mx-auto grid max-w-6xl gap-8 px-6 py-12 sm:px-8 md:grid-cols-3 md:gap-8 md:py-14">
      {signals.map((signal, index) => (
        <div class:list={[index > 0 && "border-t border-white/15 pt-8 md:border-t-0 md:border-l md:pt-0 md:pl-8"]}>
          <p class="text-lg font-bold leading-snug">{signal.label}</p>
          <p class="mt-2 text-sm leading-7 text-white/75">{signal.detail}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Why: open editorial rhythm -->
  <section class="border-b border-line bg-paper" aria-labelledby="why-heading">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <div class="max-w-2xl">
        <h2 id="why-heading" class="text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
          ทำไมต้องอ่านทันเทค
        </h2>
        <p class="mt-3 text-base leading-8 text-muted">
          สำหรับคนที่ต้องการตามข่าวเทคโนโลยีสำคัญ โดยไม่เสียเวลาอ่านต้นฉบับยาวทั้งหมด
        </p>
      </div>
      <ol class="mt-10 max-w-3xl space-y-0 border-t border-line">
        {whyItems.map((item, index) => (
          <li class="grid gap-4 border-b border-line py-6 sm:grid-cols-[4rem_1fr] sm:gap-6">
            <span class="text-sm font-bold text-brand">0{index + 1}</span>
            <p class="text-base leading-8 text-ink">{item}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Method: asymmetric -->
  <section class="border-b border-line bg-white" aria-labelledby="mission-heading">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:py-20">
      <div class="lg:sticky lg:top-8 lg:self-start">
        <h2 id="mission-heading" class="text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
          วิธีทำงานของทันเทค
        </h2>
        <p class="mt-3 max-w-md text-base leading-8 text-muted">
          หลักการที่เราใช้คัด เรียบเรียง และเผยแพร่สรุปข่าวเทคโนโลยีทุกวัน
        </p>
      </div>
      <div class="space-y-6">
        {pillars.map((item, index) => (
          <div
            class:list={[
              index === 0
                ? "rounded-2xl border border-brand/20 bg-brand-light/40 p-6"
                : "border-b border-line pb-6 last:border-b-0 last:pb-0"
            ]}
          >
            <h3 class="text-lg font-bold text-ink">{item.title}</h3>
            <p class="mt-2 text-sm leading-7 text-muted">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Partner: quieter -->
  <section class="border-b border-line bg-paper" aria-labelledby="partners-heading">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="max-w-xl">
        <h2 id="partners-heading" class="text-2xl font-bold text-ink">พันธมิตรสื่อ</h2>
        <p class="mt-2 text-muted">เครือข่ายสื่อที่ร่วมขยายการเข้าถึงข่าวเทคโนโลยีคุณภาพในไทย</p>
      </div>
      <ul class="mt-8 max-w-2xl space-y-4">
        {partners.map((partner) => (
          <li>
            <a
              href={partner.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-4 rounded-2xl border border-line bg-white p-5 transition hover:border-brand focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
            >
              <img
                src={partner.logo}
                alt={partner.logoAlt}
                width="64"
                height="64"
                class="h-14 w-14 shrink-0 rounded-full object-cover"
                loading="lazy"
              />
              <div class="min-w-0 flex-1">
                <p class="text-base font-bold text-ink group-hover:text-brand">{partner.name}</p>
                <p class="mt-1 text-sm text-muted">{partner.role}</p>
              </div>
              <span class="shrink-0 text-sm font-semibold text-brand" aria-hidden="true">ดูเว็บไซต์</span>
              <span class="sr-only"> (เปิดในแท็บใหม่)</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Close: strong CTA band -->
  <section class="bg-ink text-white" aria-labelledby="ads-heading">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:py-20">
      <div>
        <h2 id="ads-heading" class="text-3xl font-extrabold tracking-tight sm:text-4xl">
          ติดต่อโฆษณาและสอบถาม
        </h2>
        <p class="mt-4 max-w-lg text-sm leading-7 text-white/75">
          สนใจลงโฆษณา เป็นสปอนเซอร์ หรือสอบถามความร่วมมือกับทันเทค ส่งอีเมลมาได้โดยตรง
          เนื้อหาข่าวยังคงแยกจากโฆษณาอย่างชัดเจน
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={adsMailto}
            class="inline-flex min-h-11 items-center justify-center rounded-lg bg-brand px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-light"
          >
            ส่งอีเมลโฆษณา
          </a>
          <a
            href="/advertise/"
            class="inline-flex min-h-11 items-center justify-center rounded-lg border border-white/25 bg-transparent px-5 py-2.5 text-sm font-semibold text-white transition hover:border-white hover:bg-white/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-light"
          >
            รายละเอียดโฆษณา
          </a>
          <a
            href="/contact/"
            class="inline-flex min-h-11 items-center justify-center rounded-lg border border-white/25 bg-transparent px-5 py-2.5 text-sm font-semibold text-white transition hover:border-white hover:bg-white/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-light"
          >
            ติดต่อทั่วไป
          </a>
        </div>
      </div>

      <div class="border-t border-white/15 pt-10 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
        <h3 class="text-xl font-bold">นโยบายและความโปร่งใส</h3>
        <p class="mt-3 text-sm leading-7 text-white/75">
          อ่านหลักการทำงานของทันเทคเพื่อเข้าใจวิธีคัดข่าวและการใช้ AI
        </p>
        <div class="mt-6 flex flex-col gap-3 text-sm">
          <a class="font-semibold text-brand-light underline-offset-4 hover:underline" href="/selection-criteria/">
            วิธีการคัดเลือกข่าว
          </a>
          <a class="font-semibold text-brand-light underline-offset-4 hover:underline" href="/ai-policy/">
            นโยบายการใช้ AI
          </a>
          <a class="font-semibold text-brand-light underline-offset-4 hover:underline" href="/correction-policy/">
            นโยบายแก้ไขข่าว
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
