---
import ArticleCard from "../../components/news/article-card.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedNews } from "../../utils/content";
import { groupArticlesByPublishedMonth } from "../../utils/archive";

const articles = await getPublishedNews();
const groups = groupArticlesByPublishedMonth(articles);
---

<BaseLayout title="คลังข่าวย้อนหลัง" description="คลังข่าวเทคโนโลยีทั้งหมดของ TanTech News">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <h1 class="text-3xl font-extrabold text-ink">คลังข่าวย้อนหลัง</h1>
    <p class="mt-3 max-w-2xl text-muted">รวมข่าวที่ผ่านการเผยแพร่แล้ว แยกตามเดือนเพื่อย้อนอ่านได้เร็วขึ้น.</p>

    {groups.length > 0 ? (
      <div class="mt-8 grid gap-10">
        {groups.map((group) => (
          <section aria-labelledby={`archive-${group.key}`}>
            <div class="mb-4 flex items-end justify-between gap-4 border-b border-line pb-3">
              <h2 id={`archive-${group.key}`} class="text-2xl font-bold text-ink">{group.label}</h2>
              <p class="text-sm font-semibold text-muted">{group.articles.length} ข่าว</p>
            </div>
            <div class="grid gap-5 md:grid-cols-2">
              {group.articles.map((article) => <ArticleCard article={article} />)}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <p class="mt-8 rounded-lg border border-dashed border-line bg-white p-6 text-muted">ยังไม่มีข่าวในคลัง.</p>
    )}
  </section>
</BaseLayout>
