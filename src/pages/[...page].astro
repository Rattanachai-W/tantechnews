---
import type { GetStaticPaths, Page } from "astro";
import ArticleCard from "../components/news/article-card.astro";
import Pagination from "../components/common/pagination.astro";
import JsonLd from "../components/seo/json-ld.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ARTICLE_CATEGORIES } from "../types/article";
import { getCategoryHref, getPublishedNews, type NewsEntry } from "../utils/content";
import { getOrganizationJsonLd, getSiteJsonLd } from "../utils/seo";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const articles = await getPublishedNews();
  // 10 articles per page for a balanced, modern news grid
  return paginate(articles, { pageSize: 10 });
};

interface Props {
  page: Page<NewsEntry>;
}

const { page } = Astro.props;
const articles = page.data;
const isFirstPage = page.currentPage === 1;

// Split articles into two balanced columns for large screens
const half = Math.ceil(articles.length / 2);
const leftArticles = articles.slice(0, half);
const rightArticles = articles.slice(half);

const pageTitle = isFirstPage
  ? undefined
  : `ข่าวเทคโนโลยีล่าสุด — หน้า ${page.currentPage} | ทันเทค`;
const pageDescription = isFirstPage
  ? undefined
  : `รวมข่าวเทคโนโลยีล่าสุดหน้าที่ ${page.currentPage} จากทั้งหมด ${page.lastPage} หน้า อัปเดตและวิเคราะห์โดยทีมทันเทค`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <JsonLd data={getSiteJsonLd()} />
    <JsonLd data={getOrganizationJsonLd()} />
  </Fragment>

  {
    isFirstPage ? (
      /* Hero Header on Homepage */
      <section class="border-b border-line bg-white">
        <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:py-14">
          <div>
            <p class="text-sm font-bold uppercase tracking-wide text-brand">
              TanTech News
            </p>
            <h1 class="mt-3 max-w-3xl text-4xl font-extrabold leading-tight text-ink sm:text-5xl">
              สรุปข่าวเทคสำคัญ ให้คุณทันทุกวัน
            </h1>
            <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">
              คัดข่าวที่มีผลกระทบจริง สรุปเป็นภาษาไทย
              แยกข้อเท็จจริงออกจากบทวิเคราะห์ และพากลับไปอ่านต้นฉบับได้เสมอ.
            </p>
          </div>
          <nav class="rounded-lg border border-line bg-paper p-5" aria-label="หมวดหมู่ข่าว">
            <p class="text-sm font-bold text-ink">หมวดข่าวหลัก</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {ARTICLE_CATEGORIES.map((category) => (
                <a
                  class="rounded-md border border-line bg-white px-3 py-2 text-sm font-semibold text-muted hover:border-brand hover:text-brand transition-colors"
                  href={getCategoryHref(category)}
                >
                  {category}
                </a>
              ))}
            </div>
          </nav>
        </div>
      </section>
    ) : (
      /* Subpage Header for Page 2+ */
      <section class="border-b border-line bg-white">
        <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
          <nav aria-label="Breadcrumb" class="mb-4">
            <ol class="flex items-center gap-2 text-sm text-muted">
              <li>
                <a href="/" class="hover:text-brand transition-colors">หน้าแรก</a>
              </li>
              <li>/</li>
              <li class="font-semibold text-ink" aria-current="page">
                หน้า {page.currentPage}
              </li>
            </ol>
          </nav>
          <h1 class="text-3xl font-extrabold text-ink">
            ข่าวเทคโนโลยีล่าสุด <span class="text-lg font-normal text-muted">— หน้า {page.currentPage}</span>
          </h1>
        </div>
      </section>
    )
  }

  <!-- Main News Grid Section -->
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6" aria-labelledby="latest-heading">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <p class="text-sm font-bold text-brand">
          {isFirstPage ? "ข่าวล่าสุด" : `หน้า ${page.currentPage}`}
        </p>
        <h2 id="latest-heading" class="mt-1 text-2xl font-bold text-ink">
          {isFirstPage ? "เรื่องที่ควรรู้ตอนนี้" : "บทความทั้งหมด"}
        </h2>
      </div>
      <a
        class="text-sm font-bold text-brand hover:text-brand-dark transition-colors"
        href="/archive/"
      >
        ดูคลังข่าวย้อนหลัง &rarr;
      </a>
    </div>

    {
      articles.length > 0 ? (
        <div class="space-y-8">
          <div class="grid min-w-0 gap-5 lg:grid-cols-2">
            <div class="grid min-w-0 content-start gap-5">
              {leftArticles.map((article) => (
                <ArticleCard article={article} />
              ))}
            </div>
            <div class="grid min-w-0 content-start gap-5">
              {rightArticles.map((article) => (
                <ArticleCard article={article} />
              ))}
            </div>
          </div>

          <!-- Pagination Controls -->
          <Pagination page={page} class="mt-10" />
        </div>
      ) : (
        <div class="rounded-lg border border-dashed border-line bg-white p-8 text-center">
          <h3 class="text-xl font-bold text-ink">ยังไม่มีข่าวที่เผยแพร่</h3>
          <p class="mt-2 text-muted">
            เมื่อ pipeline สร้างข่าวและผ่านการ review แล้ว ข่าวล่าสุดจะแสดงที่นี่.
          </p>
        </div>
      )
    }
  </section>

  <!-- Categories Section -->
  <section class="border-t border-line bg-white" aria-labelledby="categories-heading">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
      <h2 id="categories-heading" class="text-2xl font-bold text-ink">
        สำรวจตามหมวดหมู่
      </h2>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {
          ARTICLE_CATEGORIES.map((category) => (
            <a
              class="group flex items-center justify-between rounded-lg border border-line bg-paper p-4 transition-all hover:border-brand hover:bg-white hover:shadow-sm"
              href={getCategoryHref(category)}
            >
              <span class="text-sm font-bold text-ink group-hover:text-brand transition-colors">
                {category}
              </span>
              <span class="text-xs font-semibold text-muted group-hover:text-brand transition-colors">
                &rarr;
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
