---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "ติดต่อโฆษณา";
const description =
  "สนใจลงโฆษณากับทันเทค ติดต่อผ่านอีเมลได้โดยตรง เนื้อหาข่าวแยกจากโฆษณาอย่างชัดเจน";
const adsEmail = "rattanachai.wp@gmail.com";
const mailtoHref = `mailto:${adsEmail}?subject=${encodeURIComponent("ติดต่อโฆษณา - TanTech News")}`;
---

<BaseLayout title={title} description={description}>
  <section class="border-b border-line bg-white">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:py-20">
      <p class="text-sm font-bold uppercase tracking-wide text-brand">โฆษณา</p>
      <h1 class="mt-3 text-4xl font-extrabold leading-tight text-ink sm:text-5xl">
        ติดต่อโฆษณา
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-muted">
        ทันเทครับพาร์ทเนอร์ที่ต้องการเข้าถึงผู้อ่านข่าวเทคโนโลยีภาษาไทย
        ส่งรายละเอียดมาที่อีเมลด้านล่าง เราจะตอบกลับเมื่อพิจารณาได้
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={mailtoHref}
          class="inline-flex items-center justify-center rounded-lg bg-brand px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
        >
          ส่งอีเมลติดต่อโฆษณา
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center justify-center rounded-lg border border-line bg-white px-5 py-2.5 text-sm font-semibold text-ink transition hover:border-brand hover:text-brand focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
        >
          หน้าติดต่อทั่วไป
        </a>
      </div>
      <p class="mt-4 text-sm text-muted">
        อีเมล:
        <a class="font-semibold text-brand hover:underline" href={mailtoHref}>{adsEmail}</a>
      </p>
    </div>
  </section>

  <section class="border-b border-line bg-paper" aria-labelledby="independence-heading">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
      <h2 id="independence-heading" class="text-2xl font-bold text-ink">ความเป็นอิสระของเนื้อหา</h2>
      <div class="mt-6 rounded-xl border border-line bg-white p-6 text-sm leading-7 text-muted">
        <p>
          ทันเทคแยกเนื้อหาข่าวออกจากโฆษณาอย่างชัดเจน
          การสนับสนุนหรือการลงโฆษณาไม่มีผลต่อการคัดเลือก วิเคราะห์ หรือสรุปข่าว
        </p>
        <p class="mt-3">
          ดูหลักการคัดเลือกข่าวได้ที่
          <a href="/selection-criteria/" class="font-semibold text-brand hover:underline">วิธีการคัดเลือกข่าว</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
