---
import type { GetStaticPaths, Page } from "astro";
import ArticleCard from "../../../components/news/article-card.astro";
import Pagination from "../../../components/common/pagination.astro";
import JsonLd from "../../../components/seo/json-ld.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { ARTICLE_CATEGORIES, type ArticleCategory } from "../../../types/article";
import { getCategorySeoDescription } from "../../../utils/categories";
import { getPublishedNews, type NewsEntry } from "../../../utils/content";
import { getBreadcrumbJsonLd, getCategoryJsonLd, seoDefaults } from "../../../utils/seo";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const articles = await getPublishedNews();
  const pageSize = 10;

  return ARTICLE_CATEGORIES.flatMap((category) => {
    const categoryParam = category.toLowerCase().replace(/\s+/g, "-");
    const filtered = articles.filter((article) =>
      article.data.categories.includes(category)
    );

    return paginate(filtered, {
      params: { category: categoryParam },
      pageSize,
      props: { category }
    });
  });
};

interface Props {
  page: Page<NewsEntry>;
  category: ArticleCategory;
}

const { page, category } = Astro.props;
const categoryParam = Astro.params.category ?? category.toLowerCase().replace(/\s+/g, "-");
const basePath = `/category/${categoryParam}/`;
const canonical = new URL(
  page.currentPage === 1 ? basePath : `${basePath}${page.currentPage}/`,
  Astro.site
).href;
const categoryDescription = getCategorySeoDescription(category);
const articles = page.data;
const isFirstPage = page.currentPage === 1;

const breadcrumbs = [
  { name: "หน้าแรก", url: `${seoDefaults.siteUrl}/` },
  { name: "หมวดหมู่", url: `${seoDefaults.siteUrl}/category/` },
  { name: category, url: `${seoDefaults.siteUrl}${basePath}` }
];

const title = isFirstPage
  ? `ข่าว ${category} ล่าสุด`
  : `ข่าว ${category} ล่าสุด — หน้า ${page.currentPage}`;
const description = isFirstPage
  ? categoryDescription
  : `${categoryDescription} หน้าที่ ${page.currentPage} จาก ${page.lastPage}`;
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <JsonLd data={getCategoryJsonLd(category, canonical, categoryDescription)} />
    <JsonLd data={getBreadcrumbJsonLd(breadcrumbs)} />
  </Fragment>

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted">
        {breadcrumbs.map((crumb, index) => (
          <li class="flex items-center gap-1.5">
            {index > 0 && <span aria-hidden="true" class="text-line">/</span>}
            {index < breadcrumbs.length - 1 ? (
              <a class="font-medium hover:text-brand" href={crumb.url}>{crumb.name}</a>
            ) : (
              <span class="font-semibold text-ink" aria-current="page">{crumb.name}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header>
      <h1 class="text-3xl font-extrabold text-ink">
        ข่าว {category} ล่าสุด
        {!isFirstPage && (
          <span class="text-lg font-normal text-muted"> — หน้า {page.currentPage}</span>
        )}
      </h1>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">
        {categoryDescription}
        {page.total > 0 && (
          <span class="font-medium text-ink"> — {page.total} บทความ</span>
        )}
      </p>
    </header>

    <div class="mt-8 space-y-8">
      <div class="grid min-w-0 gap-5 md:grid-cols-2">
        {articles.length > 0 ? (
          articles.map((article) => <ArticleCard article={article} />)
        ) : (
          <div class="rounded-lg border border-dashed border-line bg-white p-8 text-center md:col-span-2">
            <h2 class="text-xl font-bold text-ink">ยังไม่มีข่าวในหมวดนี้</h2>
            <p class="mt-2 text-muted">ข่าวใหม่จะปรากฏเมื่อ pipeline สร้างข่าวและผ่านการ review</p>
          </div>
        )}
      </div>

      <Pagination page={page} basePath={basePath} />
    </div>
  </section>
</BaseLayout>
