---
import BaseLayout from "./BaseLayout.astro";
import JsonLd from "../components/seo/json-ld.astro";
import { formatDateTime } from "../utils/format-date";
import type { NewsEntry } from "../utils/content";
import {
  getArticleJsonLd,
  getBreadcrumbJsonLd,
  seoDefaults,
} from "../utils/seo";
import { getOptimizedImageUrl } from "../utils/image";

interface Props {
  article: NewsEntry;
}

const { article } = Astro.props;
const { Content } = await article.render();
const canonical = new URL(
  `/news/${encodeURIComponent(article.slug)}/`,
  Astro.site,
).href;
const primaryCategory = article.data.categories[0] ?? "AI";
const categoryHref = `/category/${primaryCategory.toLowerCase().replace(/\s+/g, "-")}/`;

const breadcrumbs = [
  { name: "หน้าแรก", url: `${seoDefaults.siteUrl}/` },
  { name: primaryCategory, url: `${seoDefaults.siteUrl}${categoryHref}` },
  { name: article.data.title, url: canonical },
];

const breadcrumbJsonLd = getBreadcrumbJsonLd(breadcrumbs);
const articleJsonLd = getArticleJsonLd(article, canonical);
const reviewer = article.data.reviewedBy?.trim();
const hasReview = Boolean(reviewer && article.data.reviewedAt);
const heroImage = getOptimizedImageUrl(article.data.imageUrl, 1200);
---

<BaseLayout
  title={article.data.title}
  description={article.data.excerpt}
  ogType="article"
  image={article.data.imageUrl}
>
  <Fragment slot="head">
    <meta
      property="article:published_time"
      content={article.data.publishedAt.toISOString()}
    />
    <meta
      property="article:modified_time"
      content={article.data.publishedAt.toISOString()}
    />
    <meta
      property="article:author"
      content={article.data.author ?? "TanTech AI Desk"}
    />
    {
      article.data.categories.map((category) => (
        <meta property="article:section" content={category} />
      ))
    }
    {
      article.data.tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))
    }
    <JsonLd data={articleJsonLd} />
    <JsonLd data={breadcrumbJsonLd} />
  </Fragment>

  <article
    class="mx-auto max-w-3xl px-4 py-10 sm:px-6"
    itemscope
    itemtype="https://schema.org/NewsArticle"
  >
    <!-- Breadcrumb navigation -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted">
        {
          breadcrumbs.map((crumb, index) => (
            <li class="flex items-center gap-1.5">
              {index > 0 && (
                <span aria-hidden="true" class="text-line">
                  /
                </span>
              )}
              {index < breadcrumbs.length - 1 ? (
                <a class="font-medium hover:text-brand" href={crumb.url}>
                  {crumb.name}
                </a>
              ) : (
                <span class="font-semibold text-ink" aria-current="page">
                  {crumb.name}
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </nav>

    <header class="mb-7 border-b border-line pb-7">
      <div class="flex flex-wrap gap-2 text-xs font-semibold text-muted">
        {
          article.data.draft && (
            <span class="rounded-md bg-amber-100 px-2.5 py-1 text-amber-900">
              Draft
            </span>
          )
        }
        {
          article.data.categories.map((category) => (
            <a
              class="rounded-md bg-brand-light px-2.5 py-1 text-brand-dark hover:bg-brand hover:text-white transition-colors"
              href={`/category/${category.toLowerCase().replace(/\s+/g, "-")}/`}
            >
              {category}
            </a>
          ))
        }
      </div>
      {
        article.data.draft && (
          <p
            class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-900"
            data-pagefind-ignore
            role="alert"
          >
            บทความนี้ยังเป็น draft สำหรับ editorial review และยังไม่ควรเผยแพร่บน
            production.
          </p>
        )
      }
      <h1
        class="mt-5 text-3xl font-extrabold leading-tight text-ink sm:text-4xl"
        itemprop="headline"
      >
        {article.data.title}
      </h1>
      <p class="mt-4 text-lg leading-8 text-muted" itemprop="description">
        {article.data.excerpt}
      </p>
      <dl class="mt-6 grid gap-3 text-sm text-muted sm:grid-cols-3">
        <div>
          <dt class="font-semibold text-ink">เผยแพร่</dt>
          <dd>
            <time
              datetime={article.data.publishedAt.toISOString()}
              itemprop="datePublished"
            >
              {formatDateTime(article.data.publishedAt)}
            </time>
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-ink">เวลาอ่าน</dt>
          <dd>{article.data.readingTimeMinutes} นาที</dd>
        </div>
        <div>
          <dt class="font-semibold text-ink">แหล่งข่าว</dt>
          <dd>
            <a
              class="text-brand underline underline-offset-2"
              href={article.data.sourceUrl}
              rel="noopener noreferrer"
              target="_blank">{article.data.sourceName}</a
            >
          </dd>
        </div>
      </dl>
      <div class="mt-5 space-y-2 text-sm leading-7 text-muted" data-pagefind-ignore>
        <p>ผู้เรียบเรียง: <span class="font-semibold text-ink">{article.data.author ?? "TanTech AI Desk"}</span></p>
        <p>{article.data.aiGenerated ? "ใช้ AI ช่วยสรุปและวิเคราะห์จากแหล่งข่าวที่ระบุ" : "เรียบเรียงจากแหล่งข่าวที่ระบุ"} · <a href="/ai-policy/" class="text-brand underline underline-offset-2">วิธีใช้ AI ของทันเทค</a></p>
        {hasReview ? (
          <p>ผู้ตรวจสอบ: <span class="font-semibold text-ink">{reviewer}</span> · <time datetime={article.data.reviewedAt!.toISOString()}>{formatDateTime(article.data.reviewedAt!)}</time></p>
        ) : (
          <p>ยังไม่มีข้อมูลชื่อและวันที่ตรวจสอบโดยบรรณาธิการในบทความนี้</p>
        )}
      </div>
      {
        heroImage && (
          <div class="mt-6 overflow-hidden rounded-xl border border-line bg-paper">
            <img
              src={heroImage}
              alt={article.data.title}
              class="aspect-[16/9] w-full object-cover"
              loading="eager"
              width="1200"
              height="675"
              itemprop="image"
              onerror={article.data.imageUrl ? `this.onerror=null;this.src='${article.data.imageUrl}';` : "this.parentElement.parentElement.style.display='none';"}
            />
          </div>
        )
      }
      <!-- Hidden structured data fields -->
      <meta
        itemprop="dateModified"
        content={article.data.publishedAt.toISOString()}
      />
      <span
        itemprop="author"
        itemscope
        itemtype="https://schema.org/Organization"
        class="hidden"
      >
        <meta
          itemprop="name"
          content={article.data.author ?? "TanTech AI Desk"}
        />
      </span>
      <span
        itemprop="publisher"
        itemscope
        itemtype="https://schema.org/Organization"
        class="hidden"
      >
        <meta itemprop="name" content="TanTech News" />
      </span>
      <link itemprop="mainEntityOfPage" href={canonical} />
    </header>
    <div class="prose-news" itemprop="articleBody">
      <Content />
    </div>
    <footer class="mt-10 space-y-5 border-t border-line pt-6" data-pagefind-ignore>
      <section aria-labelledby="article-sources-heading">
        <h2 id="article-sources-heading" class="text-lg font-bold text-ink">ที่มาและเอกสารอ้างอิง</h2>
        <ul class="mt-3 space-y-3 text-sm leading-7 text-muted">
          <li>
            <a class="text-brand underline underline-offset-2" href={article.data.sourceUrl} rel="noopener noreferrer" target="_blank">{article.data.sourceName} — รายงานที่ใช้เรียบเรียงข่าว</a>
            <p>เผยแพร่ต้นฉบับ: <time datetime={article.data.sourcePublishedAt.toISOString()}>{formatDateTime(article.data.sourcePublishedAt)}</time></p>
          </li>
          {article.data.references.map((reference) => (
            <li>
              <span class="font-semibold text-ink">{reference.kind === "primary" ? "เอกสารต้นทาง" : "ข้อมูลประกอบ"}: </span>
              <a class="text-brand underline underline-offset-2" href={reference.url} rel="noopener noreferrer" target="_blank">{reference.title}</a>
            </li>
          ))}
        </ul>
        {article.data.references.length === 0 && <p class="mt-3 text-sm text-muted">บทความนี้ยังไม่ได้แนบเอกสารอ้างอิงเพิ่มเติมนอกเหนือจากรายงานข้างต้น</p>}
      </section>
      <p class="text-sm leading-7 text-muted">ส่วน “มุมมองของทันเทค” เป็นบทวิเคราะห์{article.data.aiGenerated ? "ที่สร้างด้วย AI" : "ของผู้เรียบเรียง"} แยกจากข้อเท็จจริงที่รายงานโดยแหล่งข่าว</p>
      <nav aria-label="ความโปร่งใสและการแก้ไขข่าว" class="flex flex-wrap gap-4 text-sm">
        <a class="text-brand underline underline-offset-2" href="/about-us/">เกี่ยวกับทันเทค</a>
        <a class="text-brand underline underline-offset-2" href="/correction-policy/">นโยบายแก้ไขข่าว</a>
        <a class="text-brand underline underline-offset-2" href="/contact/">แจ้งข้อมูลคลาดเคลื่อน</a>
      </nav>
    </footer>
  </article>
</BaseLayout>
