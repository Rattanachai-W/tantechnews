---
import SpeedInsights from "@vercel/speed-insights/astro";
import SiteFooter from "../components/layout/site-footer.astro";
import SiteHeader from "../components/layout/site-header.astro";
import { shouldIncludeDraftContent } from "../utils/drafts";
import { seoDefaults } from "../utils/seo";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  image?: string;
  noindex?: boolean;
}

const siteName = "ทันเทค | TanTech News";
const {
  title = siteName,
  description = seoDefaults.defaultDescription,
  ogType = "website",
  image = seoDefaults.defaultImage,
  noindex = false
} = Astro.props;
const pageTitle = title === siteName ? title : `${title} | TanTech News`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site).href;
const includeDrafts = shouldIncludeDraftContent();
const shouldNoindex = noindex || includeDrafts;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {shouldNoindex && <meta name="robots" content="noindex,nofollow" />}
    {!shouldNoindex && <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="TanTech News RSS" href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:site_name" content={seoDefaults.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="author" content="TanTech AI Desk" />
    <meta name="theme-color" content="#0f766e" />
    <slot name="head" />
  </head>
  <body class="bg-paper text-ink">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-brand focus:px-4 focus:py-2 focus:text-white focus:font-semibold">
      ข้ามไปยังเนื้อหา
    </a>
    <SiteHeader />
    {includeDrafts && (
      <div class="border-b border-amber-200 bg-amber-50 px-4 py-2 text-center text-sm font-semibold text-amber-900" data-pagefind-ignore role="alert">
        Editorial preview mode: draft content is visible and this build is marked noindex.
      </div>
    )}
    <main id="main-content" data-pagefind-body>
      <slot />
    </main>
    <SiteFooter />
    <SpeedInsights />
  </body>
</html>
