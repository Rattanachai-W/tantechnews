---
import SiteFooter from "../components/layout/site-footer.astro";
import SiteHeader from "../components/layout/site-header.astro";
import { shouldIncludeDraftContent } from "../utils/drafts";
import { seoDefaults } from "../utils/seo";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  image?: string;
}

const siteName = "ทันเทค | TanTech News";
const {
  title = siteName,
  description = seoDefaults.defaultDescription,
  ogType = "website",
  image = seoDefaults.defaultImage
} = Astro.props;
const pageTitle = title === siteName ? title : `${title} | TanTech News`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site).href;
const includeDrafts = shouldIncludeDraftContent();
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {includeDrafts && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="TanTech News RSS" href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:site_name" content={seoDefaults.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <slot name="head" />
  </head>
  <body class="bg-paper text-ink">
    <SiteHeader />
    {includeDrafts && (
      <div class="border-b border-amber-200 bg-amber-50 px-4 py-2 text-center text-sm font-semibold text-amber-900" data-pagefind-ignore>
        Editorial preview mode: draft content is visible and this build is marked noindex.
      </div>
    )}
    <main data-pagefind-body>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
