---
import { Search, Menu, X } from "lucide-astro";

const navItems = [
  { href: "/", label: "ล่าสุด" },
  { href: "/daily/", label: "ประจำวัน" },
  { href: "/archive/", label: "คลังข่าว" },
  { href: "/category/", label: "หมวดหมู่" },
  { href: "/search/", label: "ค้นหา" },
  { href: "/about-us/", label: "เกี่ยวกับเรา" }
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-line bg-white" role="banner">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href="/" class="flex items-center gap-3" aria-label="TanTech News — หน้าแรก">
      <img src="/logo.svg" alt="โลโก้ทันเทค" class="h-10 w-10" width="40" height="40" loading="eager" />
      <div>
        <p class="text-xl font-bold leading-tight text-ink">ทันเทค</p>
        <p class="text-xs font-medium uppercase tracking-wide text-muted">TanTech News</p>
      </div>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="เมนูหลัก">
      {navItems.map((item) => {
        const isActive = item.href === "/"
          ? currentPath === "/"
          : currentPath.startsWith(item.href);
        return (
          <a
            class:list={[
              "rounded-md px-3 py-2 text-sm font-semibold transition-colors",
              isActive
                ? "bg-brand-light text-brand-dark"
                : "text-muted hover:bg-paper hover:text-ink"
            ]}
            href={item.href}
            aria-current={isActive ? "page" : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-2">
      <a
        class="inline-flex h-11 w-11 items-center justify-center rounded-md border border-line bg-white text-ink transition-colors hover:bg-paper"
        href="/search/"
        aria-label="ค้นหาข่าว"
      >
        <Search size={18} aria-hidden="true" />
      </a>
      <button
        class="inline-flex h-11 w-11 items-center justify-center rounded-md border border-line bg-white text-ink transition-colors hover:bg-paper md:hidden"
        type="button"
        aria-label="เปิดเมนู"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-button
      >
        <Menu size={20} class="icon-open" aria-hidden="true" />
        <X size={20} class="icon-close hidden" aria-hidden="true" />
      </button>
    </div>
  </div>
  <div
    id="mobile-menu"
    class="hidden overflow-hidden border-t border-line bg-white md:hidden"
    data-mobile-menu
  >
    <nav class="mx-auto max-w-6xl px-4 py-3 sm:px-6" aria-label="เมนูมือถือ">
      <ul class="flex flex-col gap-1">
        {navItems.map((item) => {
          const isActive = item.href === "/"
            ? currentPath === "/"
            : currentPath.startsWith(item.href);
          return (
            <li>
              <a
                class:list={[
                  "block rounded-md px-3 py-3 text-sm font-semibold transition-colors",
                  isActive
                    ? "bg-brand-light text-brand-dark"
                    : "text-muted hover:bg-paper hover:text-ink"
                ]}
                href={item.href}
                aria-current={isActive ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const iconOpen = button?.querySelector(".icon-open");
  const iconClose = button?.querySelector(".icon-close");
  let previouslyFocused: HTMLElement | null = null;

  function getFocusable(): HTMLElement[] {
    if (!menu) return [];
    return Array.from(
      menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
    );
  }

  function setOpen(open: boolean) {
    if (!button || !menu) return;

    menu.classList.toggle("hidden", !open);
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "ปิดเมนู" : "เปิดเมนู");
    document.body.classList.toggle("overflow-hidden", open);

    if (open) {
      previouslyFocused = document.activeElement as HTMLElement | null;
      const focusable = getFocusable();
      (focusable[0] ?? menu).focus();
    } else if (previouslyFocused) {
      previouslyFocused.focus();
      previouslyFocused = null;
    }
  }

  function isOpen() {
    return button?.getAttribute("aria-expanded") === "true";
  }

  button?.addEventListener("click", () => {
    setOpen(!isOpen());
  });

  document.addEventListener("keydown", (event) => {
    if (!isOpen()) return;

    if (event.key === "Escape") {
      event.preventDefault();
      setOpen(false);
      button?.focus();
      return;
    }

    if (event.key !== "Tab" || !menu) return;

    const focusable = getFocusable();
    if (focusable.length === 0) return;

    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    const active = document.activeElement;

    if (event.shiftKey && active === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && active === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>
