---
import type { Page } from "astro";

interface Props {
  page: Page<any>;
  class?: string;
  /** Base path ending with `/`, e.g. `/` or `/category/ai/` */
  basePath?: string;
}

const { page, class: className = "", basePath = "/" } = Astro.props;
const normalizedBase = basePath.endsWith("/") ? basePath : `${basePath}/`;

function getPageNumbers(current: number, total: number): Array<number | "..."> {
  if (total <= 7) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }

  if (current <= 4) {
    return [1, 2, 3, 4, 5, "...", total];
  }

  if (current >= total - 3) {
    return [1, "...", total - 4, total - 3, total - 2, total - 1, total];
  }

  return [1, "...", current - 1, current, current + 1, "...", total];
}

const pageNumbers = getPageNumbers(page.currentPage, page.lastPage);

function getPageUrl(targetPage: number): string {
  if (targetPage === 1) return normalizedBase;
  if (normalizedBase === "/") return `/${targetPage}/`;
  return `${normalizedBase}${targetPage}/`;
}

function normalizePagerUrl(url: string | undefined): string | undefined {
  if (!url) return undefined;
  if (url === "/1" || url === "/1/") return "/";
  return url.endsWith("/") ? url : `${url}/`;
}

const prevUrl = normalizePagerUrl(page.url.prev);
const nextUrl = normalizePagerUrl(page.url.next);
---

{
  page.lastPage > 1 && (
    <nav
      class={`flex flex-col items-center justify-between gap-4 border-t border-line pt-8 sm:flex-row ${className}`}
      aria-label="การแบ่งหน้าบทความ"
    >
      <p class="text-sm text-muted">
        แสดงหน้าที่ <span class="font-bold text-ink">{page.currentPage}</span> จากทั้งหมด{" "}
        <span class="font-bold text-ink">{page.lastPage}</span> หน้า{" "}
        <span class="text-xs">({page.total} บทความ)</span>
      </p>

      <div class="flex max-w-full flex-wrap items-center justify-center gap-1.5">
        {prevUrl ? (
          <a
            href={prevUrl}
            class="inline-flex min-h-11 items-center gap-1 rounded-lg border border-line bg-white px-3 py-2 text-sm font-semibold text-ink shadow-sm transition hover:border-brand hover:text-brand"
            aria-label="หน้าก่อนหน้า"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span class="hidden sm:inline">ก่อนหน้า</span>
          </a>
        ) : (
          <span
            class="inline-flex min-h-11 cursor-not-allowed items-center gap-1 rounded-lg border border-line/60 bg-paper px-3 py-2 text-sm font-semibold text-muted"
            aria-disabled="true"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span class="hidden sm:inline">ก่อนหน้า</span>
          </span>
        )}

        <span
          class="inline-flex min-h-11 items-center rounded-lg bg-brand px-3 text-sm font-bold text-white shadow-sm sm:hidden"
          aria-current="page"
        >
          {page.currentPage} / {page.lastPage}
        </span>

        <div class="hidden items-center gap-1 sm:flex">
          {pageNumbers.map((p) => {
            if (p === "...") {
              return (
                <span class="px-2 py-1 text-sm font-medium text-muted">
                  &hellip;
                </span>
              );
            }

            const isCurrent = p === page.currentPage;
            const targetUrl = getPageUrl(p);

            return isCurrent ? (
              <span
                class="flex h-11 w-11 items-center justify-center rounded-lg bg-brand text-sm font-bold text-white shadow-sm"
                aria-current="page"
              >
                {p}
              </span>
            ) : (
              <a
                href={targetUrl}
                class="flex h-11 w-11 items-center justify-center rounded-lg border border-line bg-white text-sm font-semibold text-ink transition hover:border-brand hover:text-brand"
                aria-label={`ไปที่หน้าที่ ${p}`}
              >
                {p}
              </a>
            );
          })}
        </div>

        {nextUrl ? (
          <a
            href={nextUrl}
            class="inline-flex min-h-11 items-center gap-1 rounded-lg border border-line bg-white px-3 py-2 text-sm font-semibold text-ink shadow-sm transition hover:border-brand hover:text-brand"
            aria-label="หน้าถัดไป"
          >
            <span class="hidden sm:inline">ถัดไป</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ) : (
          <span
            class="inline-flex min-h-11 cursor-not-allowed items-center gap-1 rounded-lg border border-line/60 bg-paper px-3 py-2 text-sm font-semibold text-muted"
            aria-disabled="true"
          >
            <span class="hidden sm:inline">ถัดไป</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        )}
      </div>
    </nav>
  )
}
