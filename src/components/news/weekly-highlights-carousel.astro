---
import { ChevronLeft, ChevronRight } from "lucide-astro";
import type { NewsEntry } from "../../utils/content";
import { getArticleHref, getCategoryHref, getPrimaryCategory } from "../../utils/content";
import { getOptimizedImageUrl } from "../../utils/image";
import { formatDate } from "../../utils/format-date";

interface Props {
  articles: NewsEntry[];
}

const { articles } = Astro.props;
const slides = articles.map((article) => {
  const category = getPrimaryCategory(article);
  return {
    href: getArticleHref(article),
    title: article.data.title,
    excerpt: article.data.excerpt,
    category,
    categoryHref: getCategoryHref(category),
    dateLabel: formatDate(article.data.publishedAt),
    image: getOptimizedImageUrl(article.data.imageUrl, 1400),
    fallbackImage: article.data.imageUrl
  };
});
---

{
  slides.length > 0 && (
    <section
      class="weekly-highlights border-b border-line bg-ink text-white"
      aria-roledescription="carousel"
      aria-labelledby="weekly-highlights-heading"
      data-weekly-carousel
      data-pagefind-ignore
    >
      <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8">
        <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="text-xs font-bold uppercase tracking-wide text-brand-light">Weekly picks</p>
            <h2 id="weekly-highlights-heading" class="mt-1 text-xl font-bold sm:text-2xl">
              ไฮไลต์ประจำสัปดาห์
            </h2>
          </div>
          <div class="flex items-center gap-2">
            <button
              type="button"
              class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-white/20 bg-white/5 transition hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-light"
              aria-label="สไลด์ก่อนหน้า"
              data-weekly-prev
            >
              <ChevronLeft size={18} aria-hidden="true" />
            </button>
            <button
              type="button"
              class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-white/20 bg-white/5 transition hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-light"
              aria-label="สไลด์ถัดไป"
              data-weekly-next
            >
              <ChevronRight size={18} aria-hidden="true" />
            </button>
          </div>
        </div>

        <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-black/20">
          <div class="weekly-highlights__track flex" data-weekly-track>
            {slides.map((slide, index) => (
              <article
                class="weekly-highlights__slide relative min-w-full"
                aria-roledescription="slide"
                aria-label={`สไลด์ ${index + 1} จาก ${slides.length}`}
                data-weekly-slide
              >
                <a href={slide.href} class="group relative block min-h-[18rem] sm:min-h-[22rem]">
                  {slide.image ? (
                    <img
                      src={slide.image}
                      alt={slide.title}
                      class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
                      loading={index === 0 ? "eager" : "lazy"}
                      {...(index === 0 ? { fetchpriority: "high" } : {})}
                      width="1400"
                      height="788"
                      onerror={slide.fallbackImage ? `this.onerror=null;this.src='${slide.fallbackImage}';` : "this.style.display='none';"}
                    />
                  ) : (
                    <div class="absolute inset-0 bg-gradient-to-br from-brand to-brand-dark" />
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/15" />
                  <div class="relative flex h-full min-h-[18rem] flex-col justify-end p-5 sm:min-h-[22rem] sm:p-8">
                    <div class="flex flex-wrap items-center gap-2 text-xs font-semibold text-white/85">
                      <span class="rounded-md bg-brand px-2.5 py-1 text-white">{slide.category}</span>
                      <time>{slide.dateLabel}</time>
                    </div>
                    <h3 class="mt-3 max-w-3xl text-2xl font-extrabold leading-tight sm:text-3xl lg:text-4xl">
                      {slide.title}
                    </h3>
                    <p class="mt-3 max-w-2xl text-sm leading-7 text-white/85 line-clamp-2 sm:text-base">
                      {slide.excerpt}
                    </p>
                    <span class="mt-4 inline-flex text-sm font-bold text-brand-light">
                      อ่านต่อ
                    </span>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>

        <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap gap-2" role="tablist" aria-label="เลือกสไลด์ไฮไลต์">
            {slides.map((_, index) => (
              <button
                type="button"
                class="h-2.5 w-2.5 rounded-full bg-white/30 transition hover:bg-white/60 data-[active=true]:w-6 data-[active=true]:bg-brand-light"
                aria-label={`ไปที่สไลด์ ${index + 1}`}
                data-weekly-dot
                data-index={index}
                data-active={index === 0 ? "true" : "false"}
              />
            ))}
          </div>
          <p class="text-xs text-white/70" data-weekly-status aria-live="polite">
            1 / {slides.length}
          </p>
        </div>
      </div>
    </section>
  )
}

<style>
  .weekly-highlights__track {
    transition: transform 0.45s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .weekly-highlights__track {
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-weekly-carousel]");
  if (root) {
    const track = root.querySelector<HTMLElement>("[data-weekly-track]");
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-weekly-slide]"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-weekly-dot]"));
    const status = root.querySelector<HTMLElement>("[data-weekly-status]");
    const prev = root.querySelector<HTMLButtonElement>("[data-weekly-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-weekly-next]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let index = 0;
    let timer: number | null = null;

    function render() {
      if (!track) return;
      track.style.transform = `translateX(-${index * 100}%)`;
      dots.forEach((dot, i) => {
        dot.dataset.active = String(i === index);
      });
      if (status) status.textContent = `${index + 1} / ${slides.length}`;
    }

    function goTo(nextIndex: number) {
      if (slides.length === 0) return;
      index = (nextIndex + slides.length) % slides.length;
      render();
    }

    function stopAutoplay() {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
    }

    function startAutoplay() {
      if (reduceMotion || slides.length < 2) return;
      stopAutoplay();
      timer = window.setInterval(() => goTo(index + 1), 6000);
    }

    prev?.addEventListener("click", () => {
      goTo(index - 1);
      startAutoplay();
    });
    next?.addEventListener("click", () => {
      goTo(index + 1);
      startAutoplay();
    });
    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        goTo(Number(dot.dataset.index || 0));
        startAutoplay();
      });
    });

    root.addEventListener("mouseenter", stopAutoplay);
    root.addEventListener("mouseleave", startAutoplay);
    root.addEventListener("focusin", stopAutoplay);
    root.addEventListener("focusout", (event) => {
      if (!root.contains(event.relatedTarget as Node | null)) startAutoplay();
    });
    root.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        goTo(index - 1);
        startAutoplay();
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        goTo(index + 1);
        startAutoplay();
      }
    });

    render();
    startAutoplay();
  }
</script>
