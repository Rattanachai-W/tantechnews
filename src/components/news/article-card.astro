---
import { Clock3 } from "lucide-astro";
import type { NewsEntry } from "../../utils/content";
import { formatDate, formatDateTime } from "../../utils/format-date";
import { getArticleHref, getCategoryHref, getPrimaryCategory } from "../../utils/content";

interface Props {
  article: NewsEntry;
  prominent?: boolean;
}

const { article, prominent = false } = Astro.props;
const primaryCategory = getPrimaryCategory(article);
---

<article
  class:list={[
    "overflow-hidden rounded-lg border border-line bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md",
    prominent && "md:p-7"
  ]}
  itemscope
  itemtype="https://schema.org/NewsArticle"
>
  <div class="flex flex-wrap items-center gap-2 text-xs font-semibold text-muted">
    <a
      class="rounded-md bg-brand-light px-2.5 py-1 text-brand-dark hover:bg-brand hover:text-white transition-colors"
      href={getCategoryHref(primaryCategory)}
      itemprop="articleSection"
    >{primaryCategory}</a>
    {article.data.draft && <span class="rounded-md bg-amber-100 px-2.5 py-1 text-amber-900">Draft</span>}
    <time
      datetime={article.data.publishedAt.toISOString()}
      itemprop="datePublished"
    >
      {formatDate(article.data.publishedAt)}
    </time>
    <span class="inline-flex items-center gap-1">
      <Clock3 size={14} aria-hidden="true" />
      <span>{article.data.readingTimeMinutes} นาที</span>
    </span>
  </div>
  <h2
    class:list={[
      "mt-4 break-words font-bold leading-snug text-ink",
      prominent ? "text-2xl sm:text-3xl" : "text-xl"
    ]}
    itemprop="headline"
  >
    <a href={getArticleHref(article)} itemprop="url">{article.data.title}</a>
  </h2>
  <p class="mt-3 break-words text-sm leading-7 text-muted" itemprop="description">
    {article.data.excerpt}
  </p>
  <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-4 text-xs text-muted">
    <span itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
      <span itemprop="name">{article.data.sourceName}</span>
    </span>
    <time
      datetime={article.data.sourcePublishedAt.toISOString()}
      itemprop="dateModified"
    >
      ต้นฉบับ {formatDateTime(article.data.sourcePublishedAt)}
    </time>
  </div>
</article>
