---
import { Clock3 } from "lucide-astro";
import type { NewsEntry } from "../../utils/content";
import { formatDate, formatDateTime } from "../../utils/format-date";
import { getArticleHref, getCategoryHref, getPrimaryCategory } from "../../utils/content";
import { getOptimizedImageUrl } from "../../utils/image";
import { isPartnerArticle } from "../../utils/partners";

interface Props {
  article: NewsEntry;
  prominent?: boolean;
  compact?: boolean;
}

const { article, prominent = false, compact = false } = Astro.props;
const primaryCategory = getPrimaryCategory(article);
const isPartner = isPartnerArticle(article);
const coverImage = getOptimizedImageUrl(
  article.data.imageUrl,
  compact ? 400 : prominent ? 800 : 500
);
---

<article
  class:list={[
    "flex flex-col overflow-hidden rounded-lg border shadow-sm transition hover:-translate-y-0.5 hover:shadow-md",
    isPartner
      ? "border-accent bg-accent-light shadow-accent/20"
      : "border-line bg-white",
    compact && "h-full"
  ]}
  itemscope
  itemtype="https://schema.org/NewsArticle"
  data-partner={isPartner ? "true" : undefined}
>
  {
    isPartner ? (
      <a
        href={getArticleHref(article)}
        class:list={[
          "block bg-accent text-white transition-colors hover:bg-accent/90",
          compact ? "px-4 py-3" : "px-5 py-4",
          prominent && !compact && "md:px-7 md:py-5"
        ]}
        itemprop="url"
      >
        <p class="text-[11px] font-bold uppercase tracking-wide text-white/85">พันธมิตร</p>
        <h2
          class:list={[
            "mt-1 break-words font-bold leading-snug text-white",
            compact ? "text-base" : prominent ? "text-2xl sm:text-3xl" : "text-xl"
          ]}
          itemprop="headline"
        >
          {article.data.title}
        </h2>
      </a>
    ) : null
  }

  {
    coverImage && (
      <a
        href={getArticleHref(article)}
        class:list={[
          "block w-full overflow-hidden bg-paper",
          compact ? "aspect-[16/10]" : "aspect-[16/9]",
          isPartner ? "border-b border-accent/40" : "border-b border-line"
        ]}
      >
        <img
          src={coverImage}
          alt={article.data.title}
          class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
          loading="lazy"
          width={compact ? "400" : "500"}
          height={compact ? "250" : "281"}
          itemprop="image"
          onerror={article.data.imageUrl ? `this.onerror=null;this.src='${article.data.imageUrl}';` : "this.parentElement.style.display='none';"}
        />
      </a>
    )
  }

  <div
    class:list={[
      "flex flex-1 flex-col",
      compact ? "p-4" : "p-5",
      prominent && !compact && "md:p-7",
      isPartner && "bg-accent-light"
    ]}
  >
    <div class="flex flex-wrap items-center gap-2 text-xs font-semibold text-muted">
      {
        isPartner && (
          <span class="rounded-md bg-accent px-2.5 py-1 text-white">พันธมิตร</span>
        )
      }
      <a
        class:list={[
          "rounded-md px-2.5 py-1 transition-colors",
          isPartner
            ? "border border-accent/30 bg-white text-accent hover:bg-accent hover:text-white"
            : "bg-brand-light text-brand-dark hover:bg-brand hover:text-white"
        ]}
        href={getCategoryHref(primaryCategory)}
        itemprop="articleSection"
      >{primaryCategory}</a>
      {article.data.draft && <span class="rounded-md bg-amber-100 px-2.5 py-1 text-amber-900">Draft</span>}
      <time
        datetime={article.data.publishedAt.toISOString()}
        itemprop="datePublished"
      >
        {formatDate(article.data.publishedAt)}
      </time>
      {!compact && (
        <span class="inline-flex items-center gap-1">
          <Clock3 size={14} aria-hidden="true" />
          <span>{article.data.readingTimeMinutes} นาที</span>
        </span>
      )}
    </div>

    {
      !isPartner && (
        <h2
          class:list={[
            "mt-3 break-words font-bold leading-snug text-ink",
            compact ? "line-clamp-2 text-base" : prominent ? "mt-4 text-2xl sm:text-3xl" : "mt-4 text-xl"
          ]}
          itemprop="headline"
        >
          <a href={getArticleHref(article)} itemprop="url">{article.data.title}</a>
        </h2>
      )
    }

    <p
      class:list={[
        "break-words text-sm text-muted",
        compact ? "mt-2 line-clamp-2 leading-6" : "mt-3 line-clamp-3 leading-7"
      ]}
      itemprop="description"
    >
      {article.data.excerpt}
    </p>

    {!compact && (
      <div
        class:list={[
          "mt-auto flex flex-wrap items-center justify-between gap-3 border-t pt-4 text-xs",
          isPartner ? "border-accent/30 text-accent" : "border-line text-muted"
        ]}
      >
        <span itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
          <span itemprop="name">
            {isPartner ? `พันธมิตร · ${article.data.sourceName}` : article.data.sourceName}
          </span>
        </span>
        <time
          datetime={article.data.sourcePublishedAt.toISOString()}
          itemprop="dateModified"
        >
          เผยแพร่ {formatDateTime(article.data.sourcePublishedAt)}
        </time>
      </div>
    )}
  </div>
</article>
